{
  "name": "regen-lab",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:comments": "bun scripts/check-no-comments.ts",
    "test": "bun test",
    "bench": "bun scripts/bench.ts",
    "check": "bun run typecheck && bun run lint && bun run lint:comments && bun test && bun run bench"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "latest",
    "fast-check": "^4.3.0",
    "typescript": "^5.9.0"
  }
}
