{
  "name": "regen-lab",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aadilghani1/regen-lab.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:comments": "bun scripts/check-no-comments.ts",
    "test": "bun test",
    "regen": "bun packages/cli/src/main.ts",
    "bench": "bun scripts/bench.ts",
    "dev:viewer": "bun run --cwd packages/viewer dev",
    "build:viewer": "bun run --cwd packages/viewer build",
    "check": "bun run typecheck && bun run lint && bun run lint:comments && bun test && bun run bench"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "latest",
    "fast-check": "^4.3.0",
    "typescript": "^5.9.0"
  }
}
